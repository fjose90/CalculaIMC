# Define o comportamento padrão para todos os arquivos de texto como LF
* text=auto eol=lf

# Força arquivos de texto conhecidos a sempre usarem LF
*.kt text eol=lf
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Mantém arquivos binários intactos (imagens, ZIPs, etc.)
*.png binary
*.jpg binary
*.jar binary